# ─────────────────────────────────────────────────────────────
# Variables de entorno para la suite de integración LOCAL, aislada
# de la base de desarrollo (kram_erp).
#
# Copia este archivo a `backend/.env.test` (ya está en .gitignore,
# ver backend/.gitignore:65) y ajústalo si lo necesitas.
#
# Requiere el Postgres de docker-compose.test.yml corriendo:
#   docker compose -f docker-compose.test.yml up -d
#
# NUNCA debe apuntar a `kram_erp` (desarrollo) ni a ninguna base con
# datos reales. El script backend/scripts/test-integration-local.js
# aborta automáticamente si DATABASE_URL no contiene "kram_test".
# ─────────────────────────────────────────────────────────────

# Database — Postgres de docker-compose.test.yml (puerto 5433, NO 5432)
DATABASE_URL="postgresql://kramtest:kramtest123@localhost:5433/kram_test?schema=public"

# JWT — secreto de solo-prueba, nunca reutilizar en desarrollo/producción
JWT_SECRET="local-test-secret-do-not-use-in-prod"
JWT_EXPIRES_IN="1h"

# Server — puerto distinto del de desarrollo (3001) para poder correr
# ambos backends (dev y test) al mismo tiempo sin chocar
PORT=3002
NODE_ENV="test"

# CORS (sin uso real en tests de integración vía HTTP directo, pero requerido)
CORS_ORIGIN="http://localhost:3000"

# Desactiva explícitamente el rate limiting de login/registro para que
# corridas repetidas de la suite no se bloqueen entre sí.
# (NODE_ENV=test ya lo desactiva por sí solo — ver
# backend/src/middlewares/rate-limit.middleware.js — pero se deja
# explícito aquí por claridad y como salvaguarda si NODE_ENV cambiara).
RATE_LIMIT_DISABLED=true

# Base URL usada para construir enlaces (emails, PDFs); irrelevante en
# tests pero el código la referencia, así que debe existir.
BASE_URL="http://localhost:3002"

# Sin proxy inverso en local
TRUST_PROXY=0

# NOTA: TEST_BASE_URL no se define aquí — backend/scripts/test-integration-local.js
# lo calcula automáticamente a partir de PORT (http://localhost:<PORT>) y se lo
# pasa a Jest.
