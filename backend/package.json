{
  "name": "kram-erp-backend",
  "version": "1.0.0",
  "description": "Backend del ERP para KRAM con Node.js, Prisma y PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node src/index.js",
    "start:prod": "npx prisma migrate deploy && node src/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose",
    "test:unit": "jest --config jest.unit.config.js",
    "test:unit:coverage": "jest --config jest.unit.config.js --coverage",
    "test:all": "jest && jest --config jest.unit.config.js",
    "test:ci": "jest --ci --coverage && jest --config jest.unit.config.js --ci --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed-prod": "node prisma/seed-prod.js",
    "prisma:seed-reset": "node prisma/seed-prod.js --reset",
    "postinstall": "npx prisma generate"
  },
  "keywords": [
    "erp",
    "kram",
    "nodejs",
    "prisma",
    "postgresql"
  ],
  "author": "KRAM Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.19.1",
    "resend": "^6.12.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.0",
    "supertest": "^7.2.2"
  }
}
