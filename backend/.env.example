# Database
DATABASE_URL="postgresql://kramadmin:krampassword123@localhost:5432/kram_erp?schema=public"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS (separar múltiples orígenes con coma)
CORS_ORIGIN="http://localhost:3000,https://erp.kramhub.site"

# Base URL del backend (para enlaces en emails, etc.)
BASE_URL="http://localhost:3001"

# Proxy Trust Level (Coolify/Traefik/Nginx)
# 0 = desactivado, 1 = un nivel, 2 = dos niveles
TRUST_PROXY="1"

# Service FQDNs (para Coolify)
SERVICE_FQDN_FRONTEND="erp.kramhub.site"
SERVICE_FQDN_BACKEND="apierp.kramhub.site"

# Resend (notificaciones por email)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@pid.kramhub.site"
