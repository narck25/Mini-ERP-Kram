generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  password          String
  name              String
  role              String           @default("EMPLEADO_BASICO")
  accessibleModules ModuleType[]     @default([DASHBOARD])
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employee          Employee?
  sessions          Session[]
  VacancyComment    VacancyComment[]
  purchaseComments  PurchaseComment[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("bg-gray-100 text-gray-800")
  icon        String   @default("👤")
  isCustom    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Employee {
  id                    String             @id @default(cuid())
  userId                String?            @unique
  salarioMensual        Float?             @map("salary")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  curp                  String             @unique
  departamento_id       String
  estatus               EmployeeStatus     @default(Activo)
  fechaAlta             DateTime           @map("fecha_ingreso")
  nss                   String             @unique
  puestoId              String?
  rfc                   String             @unique
  apellidoMaterno       String?
  apellidoPaterno       String?
  area                  String?
  banco                 String?
  beneficiario1         String?
  beneficiario2         String?
  clabe                 String?
  clave                 String?            @unique
  contrato              String?
  correoElectronico     String?
  correoEmpresa         String?
  cpFiscal              String?
  direccionCompleta     String?
  estado                String?
  estadoCivil           String?
  fechaBaja             DateTime?
  fechaNacBeneficiario1 DateTime?
  fechaNacBeneficiario2 DateTime?
  fechaNacimiento       DateTime?
  horario               String?
  lugarNacimiento       String?
  nacionalidad          String?
  nivelAcademico        String?
  nombreConyuge         String?
  nombres               String?
  numeroCuenta          String?
  porcentaje1           Float?
  porcentaje2           Float?
  region                String?
  sexo                  String?
  sucursal              String?
  tallaCamisa           String?
  tallaPantalon         String?
  tallaPlayera          String?
  tallaZapatos          String?
  telefonoCasa          String?
  telefonoMovil         String?
  nombre                String?
  jefeDirecto           String?
  sd                    Float?
  sdi                   Float?
  nivelJerarquico       NivelJerarquico?   @default(OPERATIVO)
  reportaAId            String?
  fotoUrl               String?
  esPadre               Boolean            @default(false)
  numeroHijos           Int                @default(0)
  documents             EmployeeDocument[]
  departamento          Department         @relation(fields: [departamento_id], references: [id])
  user                  User?              @relation(fields: [userId], references: [id])
  reportaA              Employee?          @relation("Jerarquia", fields: [reportaAId], references: [id])
  subordinados          Employee[]         @relation("Jerarquia")
  autorizadoVacancies   JobVacancy[]       @relation("AutorizadoPor")
  jobVacancies          JobVacancy[]       @relation("Solicitante")
  voBoVacancies         JobVacancy[]       @relation("VoBoPor")
  comprasSolicitadas    PurchaseRequest[]  @relation("ComprasSolicitante")
  comprasAutorizadas    PurchaseRequest[]  @relation("ComprasAutorizador")
  purchaseApprovals     PurchaseApprover[]
  puesto                JobPosition?       @relation(fields: [puestoId], references: [id])
  salaryHistory         SalaryHistory[]
  notificationLogs      NotificationLog[]
  stationeryRequests    StationeryRequest[] @relation("PapeleriaSolicitante")
  stationeryDeliveries  StationeryRequest[] @relation("PapeleriaEntregador")
  uniformDeliveries     UniformDelivery[]   @relation("UniformeEmpleado")
  uniformDeliveriesMade UniformDelivery[]   @relation("UniformeEntregador")

  @@map("employees")
}

model JobVacancy {
  id                      String           @id @default(cuid())
  closedAt                DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  autorizadoPorId         String?
  candidatoPromocion      String?
  cargoPromocion          String?
  conocimientosExtra      String?
  entrevistadorRespaldo   String?
  entrevistadorTecnico    String?
  fechaAutorizacion       DateTime?
  fechaSolicitud          DateTime         @default(now())
  motivoSolicitud         MotivoVacante
  jobPositionId           String?
  numeroVacantes          Int              @default(1)
  observaciones           String?
  otrosRequerimientos     String?
  personaAReemplazar      String?
  reportaA                String?
  requiereExtension       Boolean          @default(false)
  requiereLaptop          Boolean          @default(false)
  requiereMovil           Boolean          @default(false)
  requierePC              Boolean          @default(false)
  solicitanteId           String
  tipoContratacion        TipoContratacion
  ubicacionFisica         String?
  voBoPorId               String?
  departamento_id         String?
  estatus                 VacancyStatus    @default(Solicitada)
  requerimientos_tecnicos Json?
  titulo                  String?
  
  // Nuevos campos para digitalización del formato físico
  personaAReemplazarNombre  String?
  personaAReemplazarCargo   String?
  noAceptanReingresos       Boolean        @default(false)
  reqComputadoraEscritorio  Boolean        @default(false)
  reqLaptop                 Boolean        @default(false)
  reqTelefonoMovil          Boolean        @default(false)
  reqExtensionTelefonica    Boolean        @default(false)
  otrosRequerimientosFisicos String?       @map("otros_requerimientos_fisicos")
  consideraPromocionInterna Boolean        @default(false)
  candidatosInternosPropuestos Json?       @map("candidatos_internos_propuestos")
  observacionesPromocion    String?        @map("observaciones_promocion")
  conocimientosAdicionales  String?        @map("conocimientos_adicionales")
  
  candidatesRH            CandidateRH[]
  JobActivity             JobActivity[]
  autorizadoPor           Employee?        @relation("AutorizadoPor", fields: [autorizadoPorId], references: [id])
  departamento            Department?      @relation(fields: [departamento_id], references: [id])
  solicitante             Employee         @relation("Solicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  voBoPor                 Employee?        @relation("VoBoPor", fields: [voBoPorId], references: [id])
  jobPosition             JobPosition?     @relation(fields: [jobPositionId], references: [id])
  comments                VacancyComment[]

  @@map("job_vacancies")
}

model JobActivity {
  id           String     @id @default(cuid())
  vacancyId    String
  activityType String
  description  String
  duration     String?
  priority     Int        @default(1)
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  vacancy      JobVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@map("job_activities")
}

model Department {
  id           String       @id @default(cuid())
  nombre       String       @unique
  descripcion  String?
  estado       String       @default("Activo")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employees    Employee[]
  jobVacancies JobVacancy[]
  jobPositions JobPosition[]
  purchaseRequests PurchaseRequest[] @relation("ComprasDepartamento")
  stationeryRequests StationeryRequest[] @relation("PapeleriaDepartamento")

  @@map("departments")
}

model JobPosition {
  id              String           @id @default(cuid())
  nombre          String
  descripcion     String?
  nivelJerarquico NivelJerarquico  @default(OPERATIVO)
  estado          String           @default("Activo")
  departamentoId  String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  departamento    Department       @relation(fields: [departamentoId], references: [id])
  employees       Employee[]
  jobVacancies    JobVacancy[]

  @@unique([nombre, departamentoId])
  @@map("job_positions")
}

model EmployeeDocument {
  id             String   @id @default(cuid())
  tipo_documento String
  url_archivo    String
  employee_id    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  mime_type      String   @default("application/octet-stream")
  nombre_archivo String
  size_bytes     Int?
  uploaded_at    DateTime @default(now())
  uploaded_by    String?
  employee       Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model VacancyComment {
  id         String     @id @default(cuid())
  vacancy_id String
  user_id    String
  mensaje    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [user_id], references: [id])
  vacancy    JobVacancy @relation(fields: [vacancy_id], references: [id], onDelete: Cascade)

  @@map("vacancy_comments")
}

model CandidateRH {
  id             String          @id @default(cuid())
  vacancy_id     String
  nombre         String
  cv_url         String?
  estatus        CandidateStatus @default(En_Revision)
  comentarios_rh String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  psych_test_url String?
  vacancy        JobVacancy      @relation(fields: [vacancy_id], references: [id], onDelete: Cascade)

  @@map("candidates_rh")
}

enum RoleType {
  EMPLEADO_BASICO
  ADMIN
  RH
  SISTEMAS
  COMPRAS
  PRODUCCION
}

enum MotivoVacante {
  NUEVA_CREACION
  REEMPLAZO_DEFINITIVO
  REEMPLAZO_TEMPORAL
  REEMPLAZO_RENUNCIA
  REEMPLAZO_TERMINACION_CONTRATO
  INCREMENTO_PLANTILLA
  INCREMENTO_PRODUCCION
  RENUNCIA
  TERMINACION_CONTRATO
  LICENCIA
  LICENCIA_TEMPORAL
  INCAPACIDAD
  JUBILACION
  JUBILACION_RETIRO
  PROMOCION
  REESTRUCTURACION
  MATERNIDAD
  LICENCIA_MATERNIDAD
  VACACIONES
}

enum TipoContratacion {
  ADMINISTRATIVO
  TEMPORAL
  SINDICALIZADO
  TIEMPO_COMPLETO
  PERMANENTE
  BECARIO
  ROL_TURNOS
}

enum EmployeeStatus {
  Activo
  Inactivo
}

enum VacancyStatus {
  Solicitada
  Aprobada
  Buscando
  Cerrada
}

enum NivelJerarquico {
  PRESIDENTE
  DIRECTOR
  GERENTE
  JEFE
  COORDINADOR
  ANALISTA
  SUPERVISOR
  AUX_ADMINISTRATIVO
  OPERATIVO
}

enum CandidateStatus {
  En_Revision
  Descartado
  Seleccionado
}

enum ModuleType {
  EMPLEADOS
  RECLUTAMIENTO
  VACACIONES
  INCIDENCIAS
  CONFIGURACION
  DASHBOARD
  REPORTES
  COMPRAS
}

enum StationeryStatus {
  PENDIENTE
  ENTREGADO
  CANCELADO
}

enum PurchaseStatus {
  NUEVO
  PENDIENTE
  EN_AUTORIZACION
  APROBADO
  ENTREGADO
  CANCELADO
}

model PurchaseRequest {
  id              String         @id @default(cuid())
  folio           Int            @default(autoincrement())
  solicitanteId   String
  departamentoId  String
  estatus         PurchaseStatus @default(NUEVO)
  fechaSolicitud  DateTime       @default(now())
  justificacion   String?
  solicitante     Employee       @relation("ComprasSolicitante", fields: [solicitanteId], references: [id])
  departamento    Department     @relation("ComprasDepartamento", fields: [departamentoId], references: [id])
  items           PurchaseItem[]
  quotes          PurchaseQuote[]
  requiereAutorizacion Boolean   @default(false)
  autorizadoPorId      String?
  autorizadoPor        Employee? @relation("ComprasAutorizador", fields: [autorizadoPorId], references: [id])
  fechaAutorizacion    DateTime?
  comments        PurchaseComment[]
  approvers       PurchaseApprover[]
  purchaseOrder   PurchaseOrder?
  createdAt       DateTime       @default(now())

  updatedAt       DateTime       @updatedAt

  @@map("purchase_requests")
}

model PurchaseItem {
  id                String          @id @default(cuid())
  requestId         String
  productoServicio  String
  cantidad          Float
  descripcion       String?
  request           PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

model PurchaseQuote {
  id                String          @id @default(cuid())
  requestId         String
  proveedor         String
  monto             Float
  fechaCotizacion   DateTime        @default(now())
  archivoUrl        String?
  isSelected        Boolean         @default(false)
  comentarios       String?
  fechaEstimadaEntrega DateTime?
  request           PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("purchase_quotes")
}

model PurchaseComment {
  id          String         @id @default(cuid())
  requestId   String
  userId      String
  mensaje     String
  createdAt   DateTime       @default(now())
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id])

  @@map("purchase_comments")
}

model AttendanceRecord {
  id              String   @id @default(cuid())
  numeroEmpleado  String   // El número del checador (ej. "592")
  nombreEmpleado  String   // Nombre tal cual viene en el reloj
  fechaHora       DateTime // Fecha y hora exacta de la checada
  tipo            String   // "Entrada" o "Salida" (o estado del reloj)
  dispositivo     String?  // Ej. "Bio Matriz"
  
  createdAt       DateTime @default(now())
  
  @@index([numeroEmpleado])
  @@index([fechaHora])
  @@map("attendance_records")
}

model FactorIntegracion {
  id              Int     @id @default(autoincrement())
  anio            Int     @unique // Año de antigüedad (1-30)
  diasAguinaldo   Int     // Días de aguinaldo (15 fijos)
  diasVacaciones  Int     // Días de vacaciones según LFT
  primaVacacional Float   // % prima vacacional (0.25 = 25%)
  factor          Float   // Factor de integración precalculado

  @@map("factores_integracion")
}

model SalaryHistory {
  id              String   @id @default(cuid())
  employeeId      String
  salarioAnterior Float?
  salarioNuevo    Float
  sdAnterior      Float?
  sdNuevo         Float
  sdiAnterior     Float?
  sdiNuevo        Float
  factorUsado     Float?
  tipoCambio      String   // 'ALTA' | 'INCREMENTO' | 'DECREMENTO' | 'AJUSTE'
  motivo          String?
  fechaCambio     DateTime @default(now())
  usuarioId       String?
  empleado        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([fechaCambio])
  @@map("salary_history")
}

model NotificationLog {
  id           String   @id @default(cuid())
  tipo         String   // 'CUMPLEANOS' | 'ANIVERSARIO'
  employeeId   String
  employeeName String
  email        String
  enviadoA     DateTime @default(now())
  estatus      String   // 'ENVIADO' | 'FALLIDO'
  errorMsg     String?
  employee     Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([tipo])
  @@index([enviadoA])
  @@map("notification_logs")
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  purchaseRequestId String              @unique
  numero            String              @unique // Formato: OC-AAAA-000001
  proveedor         String
  monto             Float
  subtotal          Float?
  iva               Float?
  ivaRate           Float?
  pdfUrl            String?
  contactoKram      String?             // Contacto del área de compras de KRAM
  lugarEntrega      String?             // Dirección o lugar de entrega
  observaciones     String?             // Observaciones adicionales para el proveedor
  createdAt         DateTime            @default(now())
  request           PurchaseRequest     @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  items             PurchaseOrderItem[]

  @@map("purchase_orders")
}


model PurchaseOrderItem {
  id                String         @id @default(cuid())
  orderId           String
  productoServicio  String
  cantidad          Float
  descripcion       String?
  precioUnitario    Float?
  importe           Float?
  order             PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model PurchaseApprover {

  id              String         @id @default(cuid())
  requestId       String
  employeeId      String
  estatus         String         @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO
  fechaRespuesta  DateTime?
  comentarios     String?
  request         PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employee        Employee       @relation(fields: [employeeId], references: [id])

  @@unique([requestId, employeeId])
  @@map("purchase_approvers")
}

model PurchaseAuditLog {
  id              String   @id @default(cuid())
  requestId       String
  userId          String
  accion          String   // CREACION | COTIZACION_SUBIDA | MONTO_EDITADO | COTIZACION_SELECCIONADA | ENVIO_AUTORIZACION | APROBACION | ENTREGA | CANCELACION
  valorAnterior   Json?
  valorNuevo      Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([requestId])
  @@index([userId])
  @@index([accion])
  @@index([createdAt])
  @@map("purchase_audit_logs")
}

// ─── PAPELERÍA Y PERIFÉRICOS ───

model StationeryRequest {
  id              String            @id @default(cuid())
  solicitanteId   String
  departamentoId  String
  estatus         StationeryStatus  @default(PENDIENTE)
  justificacion   String?
  fechaSolicitud  DateTime          @default(now())
  fechaEntrega    DateTime?
  entregadoPorId  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  solicitante     Employee          @relation("PapeleriaSolicitante", fields: [solicitanteId], references: [id])
  departamento    Department        @relation("PapeleriaDepartamento", fields: [departamentoId], references: [id])
  entregadoPor    Employee?         @relation("PapeleriaEntregador", fields: [entregadoPorId], references: [id])
  items           StationeryItem[]

  @@map("stationery_requests")
}

model StationeryItem {
  id              String            @id @default(cuid())
  requestId       String
  producto        String
  cantidad        Int
  unidad          String            @default("pzas")
  request         StationeryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("stationery_items")
}

model StationeryInventory {
  id              String   @id @default(cuid())
  producto        String   @unique
  categoria       String   @default("PAPELERIA") // PAPELERIA | PERIFERICO | OTRO
  cantidadActual  Int      @default(0)
  cantidadMinima  Int      @default(5)
  unidad          String   @default("pzas")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("stationery_inventory")
}

// ─── UNIFORMES ───

model UniformInventory {
  id              String   @id @default(cuid())
  tipo            String   // CAMISA | PANTALON | PLAYERA | ZAPATOS | CHALECO | MANDIL | GORRA
  talla           String
  genero          String?  // HOMBRE | MUJER | UNISEX
  cantidadActual  Int      @default(0)
  cantidadMinima  Int      @default(2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tipo, talla, genero])
  @@map("uniform_inventory")
}

model UniformDelivery {
  id              String   @id @default(cuid())
  empleadoId      String
  items           Json     // [{tipo, talla, cantidad}]
  fechaEntrega    DateTime @default(now())
  entregadoPorId  String
  observaciones   String?
  createdAt       DateTime @default(now())

  empleado        Employee @relation("UniformeEmpleado", fields: [empleadoId], references: [id])
  entregadoPor    Employee @relation("UniformeEntregador", fields: [entregadoPorId], references: [id])

  @@map("uniform_deliveries")
}
