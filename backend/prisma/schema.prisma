// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  RH
  SISTEMAS
  COMPRAS
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      RoleType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
  employee  Employee? // Relación con Employee
  approvedVacancies JobVacancy[] @relation("approvedBy") // Vacantes aprobadas por este usuario
  vacancyComments VacancyComment[] // Comentarios en vacantes RH

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleType @unique
  description String?
  permissions Json     // JSON array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

// Tabla de sesiones para autenticación
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

// Módulo de Reclutamiento

enum JobVacancyStatus {
  PENDIENTE
  APROBADA
  BUSCANDO
  CERRADA
}

enum EmployeeStatus {
  Activo
  Inactivo
}

enum VacancyStatus {
  Solicitada
  Aprobada
  Buscando
  Cerrada
}

enum CandidateStatus {
  En_Revision
  Descartado
  Seleccionado
}

model Employee {
  id           String   @id @default(cuid())
  nombre       String
  rfc          String   @unique
  curp         String   @unique
  nss          String   @unique
  fecha_ingreso DateTime
  estatus      EmployeeStatus @default(Activo)
  puesto       String
  departamento_id String
  departamento   Department? @relation(fields: [departamento_id], references: [id])
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  salary       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  documents    EmployeeDocument[]
  jobVacancies JobVacancy[] // Vacantes creadas por este empleado
  jobVacanciesRH JobVacancyRH[] // Vacantes RH solicitadas por este empleado

  @@map("employees")
}

model JobVacancy {
  id          String          @id @default(cuid())
  title       String
  description String
  department  String
  position    String
  salaryRange String?         // Ej: "$30,000 - $40,000"
  requirements Json           // JSON array de requisitos
  responsibilities Json       // JSON array de responsabilidades
  status      JobVacancyStatus @default(PENDIENTE)
  createdById String
  createdBy   Employee        @relation(fields: [createdById], references: [id])
  approvedById String?        // ID del usuario de RH que aprobó
  approvedBy   User?          @relation(fields: [approvedById], references: [id], name: "approvedBy")
  approvedAt   DateTime?
  closedAt     DateTime?
  activities   JobActivity[]  // Actividades del puesto
  candidates   Candidate[]    // Candidatos para esta vacante
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("job_vacancies")
}

model JobActivity {
  id           String   @id @default(cuid())
  vacancyId    String
  vacancy      JobVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  activityType String   // Ej: "Entrevista técnica", "Prueba práctica", etc.
  description  String
  duration     String?  // Ej: "2 horas"
  priority     Int      @default(1) // 1: baja, 2: media, 3: alta
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("job_activities")
}

model Candidate {
  id           String   @id @default(cuid())
  vacancyId    String
  vacancy      JobVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String
  phone        String?
  resumeUrl    String?  // URL del CV
  status       String   @default("PENDIENTE") // PENDIENTE, EN_PROCESO, RECHAZADO, CONTRATADO
  notes        String?
  interviewDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([vacancyId, email])
  @@map("candidates")
}

// Módulo de RH - Gestión de Talento

model Department {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employees   Employee[]
  jobVacanciesRH JobVacancyRH[]

  @@map("departments")
}

model EmployeeDocument {
  id             String   @id @default(cuid())
  tipo_documento String
  nombre_archivo String
  url_archivo    String
  mime_type      String   @default("application/octet-stream")
  size_bytes     Int?
  employee_id    String
  employee       Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  uploaded_by    String?  // ID del usuario que subió el documento
  uploaded_at    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("employee_documents")
}

// JobVacancy para reclutamiento (actualizado según requerimientos)
model JobVacancyRH {
  id                   String       @id @default(cuid())
  titulo               String
  departamento_id      String
  departamento         Department   @relation(fields: [departamento_id], references: [id])
  solicitante_id       String
  solicitante          Employee     @relation(fields: [solicitante_id], references: [id])
  estatus              VacancyStatus @default(Solicitada)
  requerimientos_tecnicos Json
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  comments             VacancyComment[]
  candidatesRH         CandidateRH[]

  @@map("job_vacancies_rh")
}

model VacancyComment {
  id         String   @id @default(cuid())
  vacancy_id String
  vacancy    JobVacancyRH @relation(fields: [vacancy_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  mensaje    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("vacancy_comments")
}

model CandidateRH {
  id           String         @id @default(cuid())
  vacancy_id   String
  vacancy      JobVacancyRH   @relation(fields: [vacancy_id], references: [id], onDelete: Cascade)
  nombre       String
  cv_url       String?
  estatus      CandidateStatus @default(En_Revision)
  comentarios_rh String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("candidates_rh")
}
